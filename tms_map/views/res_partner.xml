<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_tms_map" model="ir.ui.view">
        <field name="name">res.partner.form.tms.map</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Map" name="tms_map">
                    <widget name="tms_map" mode="geocoding" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>

<odoo>
    <record id="vpicktree_planned_shipment_advice_order" model="ir.ui.view">
        <field name="name">stock.picking.tree.shipment.sorting</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="shipment_advice.vpicktree" />
        <field name="mode">primary</field>
        <field name="priority">101</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute
                    name="default_order"
                >sequence_in_shipment_advice, id</attribute>
            </xpath>
        </field>
    </record>
</odoo>

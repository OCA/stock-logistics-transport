<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tms_telematics_account_comp_rule" model="ir.rule">
        <field name="name">Telematics account company</field>
        <field name="model_id" ref="model_tms_telematics_account" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True" />
    </record>
    <record id="tms_telematics_device_comp_rule" model="ir.rule">
        <field name="name">Telematics device company</field>
        <field name="model_id" ref="model_tms_telematics_device" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True" />
    </record>
    <record id="tms_telematics_odometer_comp_rule" model="ir.rule">
        <field name="name">Telematics odometer company</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle_odometer" />
        <field
            name="domain_force"
        >['|', ('account_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True" />
    </record>
</odoo>

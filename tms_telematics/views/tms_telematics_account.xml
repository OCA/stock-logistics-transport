<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_tms_telematics_account_list" model="ir.ui.view">
        <field name="name">tms.telematics.account.list</field>
        <field name="model">tms.telematics.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="provider" />
                <field name="server_url" />
                <field name="last_sync" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="view_tms_telematics_account_form" model="ir.ui.view">
        <field name="name">tms.telematics.account.form</field>
        <field name="model">tms.telematics.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_pull"
                        type="object"
                        string="Pull"
                        class="btn-primary"
                        groups="tms.group_tms_admin"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_readings"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-location-arrow"
                        >
                            <field
                                name="reading_count"
                                widget="statinfo"
                                string="Readings"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Account" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider" />
                            <field name="server_url" />
                            <field name="database_name" />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="login" />
                            <field name="password" password="True" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="last_sync" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Devices" name="devices">
                            <field name="device_ids">
                                <list>
                                    <field name="name" />
                                    <field name="external_id" />
                                    <field name="vehicle_id" />
                                    <field name="vin" />
                                    <field name="license_plate" />
                                    <field name="last_position_date" />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Connection"
                            name="connection"
                            groups="tms.group_tms_admin"
                        >
                            <group>
                                <field name="webhook_token" />
                                <field name="session_server" />
                                <field name="session_expires" />
                                <field name="feed_cursor" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tms_telematics_account" model="ir.actions.act_window">
        <field name="name">Telematics Accounts</field>
        <field name="res_model">tms.telematics.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

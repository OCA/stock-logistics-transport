<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.tms.sale.pickup</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="tms_sale.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="tms_factor_weight_uom" position="after">
                <field
                    name="tms_factor_volume_uom"
                    string="Volume UoM"
                    invisible="not tms_trip or tms_factor_type != 'volume' or trip_product_type != 'trip'"
                    required="tms_factor_type == 'volume'"
                />
            </field>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_tms_document_list" model="ir.ui.view">
        <field name="name">tms.document.list</field>
        <field name="model">tms.document</field>
        <field name="arch" type="xml">
            <list
                string="Documents"
                decoration-danger="state == 'expired'"
                decoration-warning="state == 'expiring'"
            >
                <field name="name" />
                <field name="doc_type" />
                <field name="res_ref" />
                <field name="issue_date" />
                <field name="expiry_date" />
                <field name="state" />
                <field name="critical" />
            </list>
        </field>
    </record>

    <record id="view_tms_document_form" model="ir.ui.view">
        <field name="name">tms.document.form</field>
        <field name="model">tms.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="doc_type" />
                            <field name="res_ref" />
                            <field name="res_model" invisible="1" />
                            <field name="res_id" invisible="1" />
                        </group>
                        <group>
                            <field name="state" />
                            <field name="issue_date" />
                            <field name="expiry_date" />
                            <field name="critical" />
                        </group>
                    </group>
                    <notebook>
                        <page string="File">
                            <group>
                                <field
                                    name="file_id"
                                    readonly="1"
                                    domain="[('res_model', '=', res_model), ('res_id', '=', res_id)]"
                                />
                                <div invisible="not id">
                                    <widget
                                        name="tms_document_file_replace"
                                        groups="tms_document.group_tms_document"
                                    />
                                </div>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_tms_document_search" model="ir.ui.view">
        <field name="name">tms.document.search</field>
        <field name="model">tms.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name" />
                <field name="doc_type" />
                <filter
                    string="Expired"
                    name="expired"
                    domain="[('expiry_date', '&lt;', 'today')]"
                />
                <filter
                    string="Critical"
                    name="critical"
                    domain="[('critical', '=', True)]"
                />
            </search>
        </field>
    </record>

    <record id="action_tms_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">tms.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tms_document_search" />
    </record>
</odoo>

<templates xml:space="preserve">
    <t
        t-name="tms_document.FormView"
        t-inherit="web.FormView"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('o_form_button_create')]" position="after">
            <button
                t-if="canCreate and !model.root.isNew and model.root.resModel in ['tms.driver', 'fleet.vehicle']"
                type="button"
                class="btn btn-outline-secondary o_tms_document_add_button"
                title="Add Document"
                t-on-click.stop="() => this.onTmsDocumentAdd()"
            >
                <i class="fa fa-upload me-1" />
                <span class="d-none d-sm-inline">Add Document</span>
            </button>
        </xpath>
    </t>
</templates>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Wizard Form View -->
    <record id="tms_order_from_stops_form" model="ir.ui.view">
        <field name="name">tms.order.from.stops.form</field>
        <field name="model">tms.order.from.stops</field>
        <field name="arch" type="xml">
            <form string="Create TMS Order">
                <group>
                    <group string="Order Details">
                        <field name="tms_team_id" options="{'no_create': True}" />
                        <field name="vehicle_id" options="{'no_create': True}" />
                        <field name="driver_id" options="{'no_create': True}" />
                        <field name="scheduled_date_start" />
                    </group>
                    <group string="Route">
                        <field name="origin_id" options="{'no_create': True}" />
                        <field name="return_to_origin" widget="boolean_toggle" />
                        <field
                            name="destination_id"
                            options="{'no_create': True}"
                            readonly="return_to_origin"
                        />
                    </group>
                </group>
                <group string="Selected Stops">
                    <field name="stop_count" readonly="1" />
                    <field
                        name="stop_ids"
                        widget="many2many_tags"
                        readonly="1"
                        options="{'no_create': True}"
                    />
                </group>
                <group string="Cargo Summary" colspan="2">
                    <group>
                        <field name="total_weight" readonly="1" />
                        <field name="total_volume" readonly="1" />
                    </group>
                </group>
                <group
                    string="Capacity Utilization"
                    colspan="2"
                    invisible="not vehicle_id"
                >
                    <group>
                        <field name="weight_capacity" readonly="1" />
                        <field name="weight_utilization" widget="progressbar" />
                    </group>
                    <group>
                        <field name="volume_capacity" readonly="1" />
                        <field name="volume_utilization" widget="progressbar" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_create_order"
                        type="object"
                        string="Create Order"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_tms_order_from_stops" model="ir.actions.act_window">
        <field name="name">Create TMS Order</field>
        <field name="res_model">tms.order.from.stops</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Server Action: Create Order from Selected Stops (binding for tree view) -->
    <record id="action_create_order_from_stops" model="ir.actions.server">
        <field name="name">Create Delivery Order</field>
        <field name="model_id" ref="model_tms_order_stop" />
        <field name="binding_model_id" ref="model_tms_order_stop" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
# Filter only unallocated stops
unallocated = records.filtered(lambda s: not s.order_id)
if not unallocated:
    raise UserError("All selected stops are already allocated to an order.")

action = {
    "type": "ir.actions.act_window",
    "name": "Create TMS Order",
    "res_model": "tms.order.from.stops",
    "view_mode": "form",
    "target": "new",
    "context": {"default_stop_ids": unallocated.ids},
}
        </field>
    </record>
</odoo>

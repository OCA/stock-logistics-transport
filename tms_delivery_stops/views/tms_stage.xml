<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend TMS Stage Form View -->
    <record id="tms_stage_form_inherit_delivery_stops" model="ir.ui.view">
        <field name="name">tms.stage.form.inherit.delivery.stops</field>
        <field name="model">tms.stage</field>
        <field name="inherit_id" ref="tms.tms_stage_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group/group[2]" position="inside">
                <field name="stop_state_sync" invisible="stage_type != 'order'" />
            </xpath>
        </field>
    </record>
</odoo>

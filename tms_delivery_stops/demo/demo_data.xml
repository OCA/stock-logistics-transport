    <!-- Demo TMS Orders with Stops -->
    <record id="demo_tms_order_with_stops_1" model="tms.order">
        <field name="name">ORD-DEMO-001</field>
        <field name="tms_team_id" ref="tms.demo_team_1" />
        <field name="origin_id" ref="demo_depot_location" />
    </record>

    <record id="demo_tms_order_stop_1" model="tms.order.stop">
        <field name="order_id" ref="demo_tms_order_with_stops_1" />
        <field name="sequence">10</field>
        <field name="partner_id" ref="demo_partner_delivery_1" />
        <field name="weight">500</field>
        <field name="weight_uom_id" ref="uom.product_uom_kgm" />
        <field name="volume">2.5</field>
        <field name="volume_uom_id" ref="uom.product_uom_cubic_meter" />
        <field name="unloading_time">30</field>
        <field
            name="scheduled_date"
            eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"
        />
        <field name="state">draft</field>
    </record>


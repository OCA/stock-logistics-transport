<odoo noupdate="1">
    <record id="demo_team_1" model="tms.team">
        <field name="name">Team Mexico Cargo</field>
        <field
            name="vehicle_ids"
            eval="[(6, 0, [ref('demo_vehicle_truck_volvo_fh'), ref('demo_vehicle_truck_actros'), ref('demo_vehicle_truck_scania_r'), ref('demo_vehicle_truck_npr')])]"
        />
        <field
            name="driver_ids"
            eval="[(6, 0, [ref('demo_driver_1'), ref('demo_driver_2'), ref('demo_driver_3'), ref('demo_driver_6')])]"
        />
    </record>

    <record id="demo_team_mexico_passenger" model="tms.team">
        <field name="name">Team Mexico Passenger</field>
        <field
            name="vehicle_ids"
            eval="[(6, 0, [ref('demo_vehicle_bus_tourismo'), ref('demo_vehicle_bus_9700'), ref('demo_vehicle_bus_irizar')])]"
        />
        <field
            name="driver_ids"
            eval="[(6, 0, [ref('demo_driver_7'), ref('demo_driver_8'), ref('demo_driver_9')])]"
        />
    </record>

    <record id="demo_team_2" model="tms.team">
        <field name="name">Team USA Cargo</field>
        <field
            name="vehicle_ids"
            eval="[(6, 0, [ref('demo_vehicle_truck_cascadia'), ref('demo_vehicle_truck_t680')])]"
        />
        <field
            name="driver_ids"
            eval="[(6, 0, [ref('demo_driver_4'), ref('demo_driver_5')])]"
        />
    </record>

    <record id="demo_team_usa_passenger" model="tms.team">
        <field name="name">Team USA Passenger</field>
        <field
            name="vehicle_ids"
            eval="[(6, 0, [ref('demo_vehicle_bus_citaro'), ref('demo_vehicle_bus_yutong'), ref('demo_vehicle_bus_prevost')])]"
        />
        <field name="driver_ids" eval="[(6, 0, [ref('demo_driver_10')])]" />
    </record>
</odoo>

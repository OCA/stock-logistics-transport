<odoo>
    <record id="fleet_vehicle_inherit_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.inherit.view.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form//notebook" position="inside">
                <page string="Transport">
                    <group>
                        <group name="operation" string="Operation">
                            <field
                                name="operation"
                                widget="radio"
                                options="{'horizontal': True}"
                            />
                            <field name="tms_equipment_type" />
                            <field
                                name="tms_location_id"
                                invisible="tms_equipment_type == 'power'"
                            />
                            <label
                                for="capacity"
                                invisible="tms_equipment_type == 'dolly' or (tms_equipment_type == 'power' and not operation)"
                            >Capacity</label>
                            <div
                                class="d-flex w-50"
                                invisible="tms_equipment_type == 'dolly' or (tms_equipment_type == 'power' and not operation)"
                            >
                                <field name="capacity" class="w-50" />
                                <field
                                    name="cargo_uom_id"
                                    invisible="operation != 'cargo' and tms_equipment_type != 'trailer'"
                                    class="w-50"
                                />
                                <span
                                    invisible="operation != 'passenger'"
                                    class="w-50"
                                >Passengers
                                </span>
                            </div>
                            <label
                                for="weight_capacity"
                                invisible="tms_equipment_type == 'dolly' or operation == 'passenger' or (tms_equipment_type == 'power' and operation != 'cargo')"
                            >Payload</label>
                            <div
                                class="d-flex w-50"
                                invisible="tms_equipment_type == 'dolly' or operation == 'passenger' or (tms_equipment_type == 'power' and operation != 'cargo')"
                            >
                                <field name="weight_capacity" class="w-50" />
                                <field name="weight_uom_id" class="w-50" />
                            </div>
                        </group>
                        <group name="insurance" string="Insurance">
                            <field
                                name="insurance_id"
                                string="Insurance Policy"
                                widget="many2many_tags"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='driver_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='driver_id']" position="after">
                <field name="tms_driver_id" />
            </xpath>
            <xpath expr="//button[field[@name='odometer_count']]" position="attributes">
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
            <xpath expr="//field[@name='acquisition_date']" position="attributes">
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
            <xpath expr="//field[@name='write_off_date']" position="attributes">
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
            <xpath expr="//label[@for='odometer']" position="attributes">
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
            <xpath expr="//div[field[@name='odometer']]" position="attributes">
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
            <xpath expr="//field[@name='seats']" position="attributes">
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
            <xpath expr="//field[@name='doors']" position="attributes">
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
            <xpath expr="//field[@name='trailer_hook']" position="attributes">
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
            <xpath
                expr="//page[@name='page_model']//field[@name='fuel_type']/parent::group"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
            <xpath
                expr="//page[@name='page_model']//field[@name='transmission']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_model_view_form_tms" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.form.tms</field>
        <field name="model">fleet.vehicle.model</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_model_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='information']//field[@name='model_year']/parent::group"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
            <xpath expr="//group[@name='group_engine']" position="attributes">
                <attribute
                    name="invisible"
                >vehicle_type not in ('car', 'truck', 'bus')</attribute>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_search_tms" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.tms</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='cars']" position="after">
                <filter
                    string="Trucks"
                    name="trucks"
                    domain="[('vehicle_type', '=', 'truck')]"
                />
                <filter
                    string="Buses"
                    name="buses"
                    domain="[('vehicle_type', '=', 'bus')]"
                />
            </xpath>
        </field>
    </record>
</odoo>

<odoo>
    <!-- Drivers -->
    <record id="view_tms_driver_list" model="ir.ui.view">
        <field name="name">tms.driver.list</field>
        <field name="model">tms.driver</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name" string="Name" />
                <field name="phone" />
                <field name="stage_id" />
            </list>
        </field>
    </record>

    <record id="view_tms_driver_form_inherit" model="ir.ui.view">
        <field name="name">tms.driver.form.inherit</field>
        <field name="model">tms.driver</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <field
                        name="stage_id"
                        widget="statusbar"
                        domain="[('stage_type', '=', 'driver')]"
                        options="{'clickable':True, 'fold_field':'fold'}"
                    />
                </header>
            </xpath>
            <xpath expr="//field[@name='company_type']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//span[@name='address_name']" position="attributes">
                <attribute name="invisible">False</attribute>
            </xpath>

            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//group" position="after">
                <group>
                    <group string="Driver Status">
                        <field name="is_external" />
                        <field name="is_training" />
                    </group>
                    <group string="Driver Type">
                        <field name="driver_type" />
                        <field
                            name="driver_license_type"
                            string="Licence Type"
                            invisible="not driver_type == 'terrestrial'"
                        />
                        <field
                            name="driver_license_number"
                            string="Licence No."
                            invisible="not driver_type == 'terrestrial'"
                        />
                        <field
                            name="driver_license_expiration_date"
                            string="Licence Expiration Date"
                            invisible="not driver_type == 'terrestrial'"
                        />
                        <field
                            name="driver_license_file"
                            string="License File"
                            invisible="not driver_type == 'terrestrial'"
                        />
                    </group>
                    <group
                        string="Driver Experience"
                        invisible="not driver_type == 'terrestrial'"
                    >
                        <label for="distance_traveled">Distance Traveled</label>
                        <div class="d-flex w-25">
                            <field name="distance_traveled" class="w-25" />
                            <field name="distance_traveled_uom" class="w-50" />
                        </div>
                        <field name="driving_experience_years" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_tms_driver_kanban" model="ir.ui.view">
        <field name="name">tms.driver.view.kanban</field>
        <field name="model">tms.driver</field>
        <field name="arch" type="xml">
            <kanban
                class="o_kanban_dashboard o_emphasize_colors"
                default_group_by="stage_id"
                group_create="False"
                group_edit="False"
            >
                <field name="display_name" />
                <field name="tms_team_id" />
                <field name="crew_ids" />
                <field name="phone" />
                <field name="is_active" />
                <field name="avatar_128" />
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field
                                name="avatar_128"
                                alt="Driver"
                                widget="image"
                                options="{'img_class': 'object-fit-cover rounded-circle'}"
                            />
                        </aside>
                        <main class="ps-2">
                            <field name="display_name" class="mb-0 fw-bold" />
                            <div
                                t-if="record.phone.raw_value"
                                class="text-truncate text-muted"
                            >
                                <i class="fa fa-fw me-1 fa-phone" title="Phone" />
                                <field name="phone" />
                            </div>
                            <div
                                t-if="record.tms_team_id.raw_value"
                                class="text-truncate text-muted"
                            >
                                <i class="fa fa-fw me-1 fa-users" title="Team" />
                                <field name="tms_team_id" />
                            </div>
                            <div
                                t-if="record.crew_ids.raw_value.length"
                                groups="tms.group_tms_crew"
                                class="text-muted"
                            >
                                <span>Crews: </span>
                                <field name="crew_ids" widget="many2many_tags" />
                            </div>
                            <footer class="pt-2">
                                <field name="is_active" widget="boolean_toggle" />
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_tms_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">tms.driver</field>
        <field name="domain">[('is_company', '=', False)]</field>
        <field name="view_mode">kanban,list,form</field>
        <field
            name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_tms_driver_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_tms_driver_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_tms_driver_form_inherit')}),
            ]"
        />
    </record>

    <record id="action_tms_config_stage_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">tms.driver</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

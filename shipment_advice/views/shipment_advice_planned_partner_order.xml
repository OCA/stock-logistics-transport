<odoo>
    <record id="view_shipment_advice_planned_partner_order_tree" model="ir.ui.view">
        <field name="name">shipment.advice.planned.partner.order.order.tree</field>
        <field name="model">shipment.advice.planned.partner.order</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="partner_id" />
                <field name="stock_picking_ids" widget="many2many_tags" />
            </tree>
        </field>
    </record>

    <record
        id="action_shipment_advice_planned_partner_order"
        model="ir.actions.act_window"
    >
        <field name="name">Planned Partner Orders</field>
        <field name="res_model">shipment.advice.planned.partner.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_shipment_advice_planned_partner_order_tree" />
    </record>
</odoo>

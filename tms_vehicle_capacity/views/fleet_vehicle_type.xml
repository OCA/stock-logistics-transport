<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View for Fleet Vehicle Type -->
    <record id="fleet_vehicle_type_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.type.tree</field>
        <field name="model">fleet.vehicle.type</field>
        <field name="arch" type="xml">
            <list string="Vehicle Types">
                <field name="code" />
                <field name="name" />
                <field name="default_weight_capacity" />
                <field name="default_volume_capacity" />
                <field name="default_cost_per_km" />
                <field name="default_minimum_trip_cost" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Form View for Fleet Vehicle Type -->
    <record id="fleet_vehicle_type_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.type.form</field>
        <field name="model">fleet.vehicle.type</field>
        <field name="arch" type="xml">
            <form string="Vehicle Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="currency_id" />
                        </group>
                    </group>
                    <group string="Default Capacity">
                        <group>
                            <field name="default_weight_capacity" />
                            <field name="default_volume_capacity" />
                        </group>
                    </group>
                    <group string="Default Costs">
                        <group>
                            <field name="default_cost_per_km" />
                            <field name="default_minimum_trip_cost" />
                        </group>
                    </group>
                    <field name="description" colspan="4" />
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Fleet Vehicle Type -->
    <record id="fleet_vehicle_type_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.type.search</field>
        <field name="model">fleet.vehicle.type</field>
        <field name="arch" type="xml">
            <search string="Vehicle Types">
                <field name="name" />
                <field name="code" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    name="inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <!-- Action for Fleet Vehicle Type -->
    <record id="action_fleet_vehicle_type" model="ir.actions.act_window">
        <field name="name">Vehicle Types</field>
        <field name="res_model">fleet.vehicle.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                    Create a new vehicle type
                </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_fleet_vehicle_type"
        name="Vehicle Types"
        parent="fleet.fleet_configuration"
        action="action_fleet_vehicle_type"
        sequence="10"
    />
</odoo>

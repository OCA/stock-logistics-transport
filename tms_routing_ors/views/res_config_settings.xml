<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tms.routing.ors</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="tms.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='tms']" position="inside">
                <block title="Routing" name="tms_routing_ors_settings">
                    <setting
                        string="OpenRouteService"
                        help="API key used to compute the distance and duration of a route. The company pays for this key."
                    >
                        <field name="tms_routing_ors_api_key" password="True" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

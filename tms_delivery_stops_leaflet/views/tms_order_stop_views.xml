<odoo>
    <!-- Leaflet Map View for TMS Order Stops -->
    <record id="view_tms_order_stop_leaflet_map" model="ir.ui.view">
        <field name="name">tms.order.stop.leaflet_map</field>
        <field name="model">tms.order.stop</field>
        <field name="arch" type="xml">
            <leaflet_map
                js_class="tms_stops_map"
                field_latitude="latitude"
                field_longitude="longitude"
                field_title="display_name"
                field_address="display_address"
                show_pin_list="1"
                numbered_markers="1"
                routing="1"
                enable_navigation="1"
                panel_title="Delivery Stops"
                group_by="order_id"
                draggable="1"
                group_field="order_id"
                default_order="sequence"
                unassigned_group_name="Sem Viagem"
            >
                <field name="display_name" />
                <field name="partner_id" />
                <field name="partner_name" />
                <field name="partner_phone" />
                <field name="partner_mobile" />
                <field name="latitude" />
                <field name="longitude" />
                <field name="display_address" />
                <field name="sequence" />
                <field name="order_id" />
                <field name="order_name" />
                <field name="state" />
                <field name="state_display" />
                <field name="weight" />
                <field name="volume" />
                <field name="package_count" />
                <field name="scheduled_date" />
            </leaflet_map>
        </field>
    </record>

    <!-- Action for Delivery Stops Map -->
    <record id="action_tms_order_stop_map" model="ir.actions.act_window">
        <field name="name">Delivery Stops Map</field>
        <field name="res_model">tms.order.stop</field>
        <field name="view_mode">leaflet_map,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No delivery stops found
            </p>
            <p>
                Create delivery stops from TMS Orders to see them on the map.
            </p>
        </field>
    </record>

    <!-- Register leaflet_map view for the action -->
    <record id="action_tms_order_stop_map_view_map" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">leaflet_map</field>
        <field name="view_id" ref="view_tms_order_stop_leaflet_map" />
        <field name="act_window_id" ref="action_tms_order_stop_map" />
    </record>

    <!-- Menu entry for Delivery Stops Map -->
    <menuitem
        id="menu_tms_delivery_stops_map"
        name="Map"
        parent="tms_delivery_stops.menu_tms_order_stop_submenu"
        action="action_tms_order_stop_map"
        sequence="30"
    />

    <!-- Add Map button to Stop form view -->
    <record id="view_tms_order_stop_form_map_button" model="ir.ui.view">
        <field name="name">tms.order.stop.form.map.button</field>
        <field name="model">tms.order.stop</field>
        <field name="inherit_id" ref="tms_delivery_stops.tms_order_stop_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="action_open_in_map"
                        type="object"
                        string="View on Map"
                        icon="fa-map-marker"
                        class="oe_highlight"
                    />
                    <button
                        name="action_open_google_maps"
                        type="object"
                        string="Google Maps"
                        icon="fa-external-link"
                        invisible="not order_id"
                    />
                </header>
            </xpath>
        </field>
    </record>

    <!-- Add leaflet_map to stops list action -->
    <record id="tms_delivery_stops.action_tms_order_stop" model="ir.actions.act_window">
        <field name="view_mode">list,form,leaflet_map</field>
    </record>

    <!-- Register leaflet_map view for stops list action -->
    <record id="action_tms_order_stop_view_map" model="ir.actions.act_window.view">
        <field name="sequence" eval="30" />
        <field name="view_mode">leaflet_map</field>
        <field name="view_id" ref="view_tms_order_stop_leaflet_map" />
        <field name="act_window_id" ref="tms_delivery_stops.action_tms_order_stop" />
    </record>
</odoo>

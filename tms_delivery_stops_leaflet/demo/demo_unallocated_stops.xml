    <!--
    Unallocated stops (no order_id).
    These will appear in the "Sem Viagem" group on the map.
    -->
    <record id="demo_stop_unallocated_1" model="tms.order.stop">
        <field name="partner_id" ref="demo_partner_unallocated_1" />
        <field name="weight">450</field>
        <field name="weight_uom_id" ref="uom.product_uom_kgm" />
        <field name="volume">2.2</field>
        <field name="volume_uom_id" ref="uom.product_uom_cubic_meter" />
        <field name="package_count">5</field>
        <field name="unloading_time">25</field>
        <field
            name="scheduled_date"
            eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')"
        />
        <field name="state">draft</field>
    </record>


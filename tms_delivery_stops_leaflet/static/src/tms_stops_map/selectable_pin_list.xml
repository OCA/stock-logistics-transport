SelectablePinList template - extends DraggablePinList with selection support
and capacity comparison features.
-->
<templates xml:space="preserve">

    <t
        t-name="tms_delivery_stops_leaflet.SelectablePinList"
        t-inherit="web_view_leaflet_map.DraggablePinList"
        t-inherit-mode="primary"
        owl="1"
    >
        <!-- Add selection bar after stats div (inline) -->
        <xpath expr="//div[contains(@class, 'o_pin_list_stats')]" position="after">
            <t t-if="selectedCount > 0">
                <div
                    class="o_tms_selection_bar d-flex align-items-center gap-2 px-2 py-2 bg-primary-subtle border-bottom"
                >
                    <span class="badge bg-primary">
                        <t t-esc="selectedCount" /> selecionado(s)
                    </span>
                    <button
                        class="btn btn-sm btn-primary ms-auto"
                        t-on-click="onCreateOrder"
                    >
                        <i class="fa fa-plus me-1" />Criar Ordem
                    </button>
                    <button
                        class="btn btn-sm btn-outline-secondary"
                        t-on-click="clearSelection"
                        title="Limpar seleção"
                    >
                        <i class="fa fa-times" />
                    </button>
                </div>

                <!-- Floating status bar with selection totals -->
                <div class="o_tms_status_bar">
                    <div class="o_status_bar_section">
                        <div class="o_status_bar_title">Selecionado</div>
                        <div class="o_status_bar_content">
                            <div class="o_status_item">
                                <i class="fa fa-map-marker" />
                                <span
                                    class="o_status_value"
                                    t-esc="selectionStats.stopCount"
                                />
                                <span class="o_status_label">paradas</span>
                            </div>
                            <div class="o_status_item">
                                <i class="fa fa-balance-scale" />
                                <span
                                    class="o_status_value"
                                    t-esc="selectionStats.totalWeight"
                                />
                                <span class="o_status_label">kg</span>
                            </div>
                            <div class="o_status_item">
                                <i class="fa fa-cube" />
                                <span
                                    class="o_status_value"
                                    t-esc="selectionStats.totalVolume"
                                />
                                <span class="o_status_label">m³</span>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>

        <!-- Add "select all" checkbox in unassigned group header (before the group name span) -->
        <xpath
            expr="//div[contains(@t-attf-class, 'o_pin_group_header')]//span[contains(@class, 'o_pin_group_name')]"
            position="before"
        >
            <t t-if="group.isUnassigned">
                <input
                    type="checkbox"
                    class="form-check-input o_tms_select_all_checkbox me-2"
                    t-att-checked="isGroupAllSelected(group)"
                    t-on-click="(ev) => this.toggleSelectAll(ev, group)"
                    t-on-mousedown.stop=""
                    title="Selecionar todos"
                />
            </t>
        </xpath>

        <!-- Hide count badge for non-unassigned groups (will show in capacity line) -->
        <xpath
            expr="//span[contains(@t-attf-class, 'o_pin_group_count')]"
            position="attributes"
        >
            <attribute
                name="t-attf-class"
            >o_pin_group_count badge {{ group.isUnassigned ? 'bg-warning' : 'd-none' }} ms-auto</attribute>
        </xpath>

        <!-- Make group name clickable for assigned groups -->
        <xpath
            expr="//div[contains(@t-attf-class, 'o_pin_group_header')]//span[contains(@class, 'o_pin_group_name')]"
            position="attributes"
        >
            <attribute
                name="t-attf-class"
            >o_pin_group_name {{ group.isUnassigned ? '' : 'o_clickable_order_name' }}</attribute>
            <attribute
                name="t-on-click"
            >(ev) => !group.isUnassigned and this.onOrderNameClick(ev, group)</attribute>
        </xpath>

        <!-- Add scheduled date after group name for assigned groups -->
        <xpath
            expr="//div[contains(@t-attf-class, 'o_pin_group_header')]//span[contains(@class, 'o_pin_group_name')]"
            position="after"
        >
            <t t-if="!group.isUnassigned">
                <t t-set="orderInfo" t-value="getGroupOrderInfo(group)" />
                <t t-if="orderInfo and orderInfo.scheduledDate">
                    <span class="o_group_scheduled_date text-muted small ms-auto">
                        <i class="fa fa-calendar" />
                        <t t-esc="orderInfo.scheduledDate" />
                    </span>
                </t>
            </t>
        </xpath>

        <!-- Hide original navigate all button for assigned groups (moved to capacity line) -->
        <xpath
            expr="//a[contains(@class, 'o_group_navigate_all')]"
            position="attributes"
        >
            <attribute
                name="t-attf-class"
            >o_group_navigate_all btn btn-sm btn-outline-primary ms-2 {{ group.isUnassigned ? '' : 'd-none' }}</attribute>
        </xpath>

        <!-- Add capacity line after group header for assigned groups -->
        <xpath
            expr="//div[contains(@t-attf-class, 'o_pin_group_header')]"
            position="after"
        >
            <t t-if="!group.isUnassigned">
                <t t-set="capacity" t-value="getGroupCapacity(group)" />
                <t t-if="capacity">
                    <div class="o_group_capacity_line">
                        <span class="o_capacity_item">
                            <i class="fa fa-truck" />
                            <t t-esc="group.records.length" />
                        </span>
                        <!-- Show weight: % if capacity defined, otherwise total -->
                        <t t-if="capacity.hasCapacity and capacity.weightCapacity > 0">
                            <span
                                t-attf-class="o_capacity_item {{ capacity.weightUtilization > 100 ? 'text-danger' : capacity.weightUtilization > 80 ? 'text-warning' : 'text-success' }}"
                            >
                                <i class="fa fa-balance-scale" />
                                <t t-esc="Math.round(capacity.weightUtilization)" />%
                            </span>
                        </t>
                        <t t-else="">
                            <span class="o_capacity_item">
                                <i class="fa fa-balance-scale" />
                                <t t-esc="capacity.totalWeight.toFixed(1)" /> kg
                            </span>
                        </t>
                        <!-- Show volume: % if capacity defined, otherwise total -->
                        <t t-if="capacity.hasCapacity and capacity.volumeCapacity > 0">
                            <span
                                t-attf-class="o_capacity_item {{ capacity.volumeUtilization > 100 ? 'text-danger' : capacity.volumeUtilization > 80 ? 'text-warning' : 'text-success' }}"
                            >
                                <i class="fa fa-cube" />
                                <t t-esc="Math.round(capacity.volumeUtilization)" />%
                            </span>
                        </t>
                        <t t-else="">
                            <span class="o_capacity_item">
                                <i class="fa fa-cube" />
                                <t t-esc="capacity.totalVolume.toFixed(2)" /> m³
                            </span>
                        </t>
                        <!-- Google Maps navigation link -->
                        <t t-if="getGroupGoogleMapsUrl(group)">
                            <a
                                class="o_capacity_item o_capacity_maps_link ms-auto"
                                t-att-href="getGroupGoogleMapsUrl(group)"
                                target="_blank"
                                t-on-click.stop=""
                                title="Navegar com Google Maps"
                            >
                                <i class="fa fa-map-marker" />
                                <span>Maps</span>
                            </a>
                        </t>
                    </div>
                </t>
            </t>
        </xpath>

        <!-- Add driver/vehicle line after group header for assigned groups -->
        <xpath
            expr="//div[contains(@t-attf-class, 'o_pin_group_header')]"
            position="after"
        >
            <t t-if="!group.isUnassigned">
                <t t-set="orderInfo" t-value="getGroupOrderInfo(group)" />
                <t t-if="orderInfo and (orderInfo.driverName or orderInfo.vehicleName)">
                    <div class="o_group_driver_line">
                        <t t-if="orderInfo.driverName">
                            <span class="o_driver_item">
                                <i class="fa fa-user" />
                                <t t-esc="orderInfo.driverName" />
                            </span>
                        </t>
                        <t t-if="orderInfo.vehicleName">
                            <span class="o_driver_item">
                                <i class="fa fa-truck" />
                                <t t-esc="orderInfo.vehicleName" />
                            </span>
                        </t>
                    </div>
                </t>
            </t>
        </xpath>

        <!-- Add checkbox in each item of unassigned group (before drag handle) -->
        <xpath
            expr="//div[contains(@t-attf-class, 'o_pin_item_draggable')]//span[contains(@class, 'o_drag_handle')]"
            position="before"
        >
            <t t-if="isUnassigned(record)">
                <input
                    type="checkbox"
                    class="form-check-input o_tms_stop_checkbox me-1"
                    t-att-checked="isSelected(record.id)"
                    t-on-click="(ev) => this.toggleSelection(ev, record.id)"
                    t-on-mousedown.stop=""
                />
            </t>
        </xpath>

        <!-- Modify tooltip of pin title to show weight/volume -->
        <xpath expr="//div[contains(@class, 'o_pin_title')]" position="attributes">
            <attribute name="t-att-title">getItemTooltip(record)</attribute>
        </xpath>
    </t>

</templates>

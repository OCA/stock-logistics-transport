<templates xml:space="preserve">

    <t
        t-name="tms_delivery_stops_leaflet.TmsStopsMapRenderer"
        t-inherit="web_view_leaflet_map.LeafletMapRenderer"
        t-inherit-mode="primary"
        owl="1"
    >
        <!-- Override PinList component to use SelectablePinList with onDataReload -->
        <xpath expr="//t[@t-component='PinListComponent']" position="attributes">
            <attribute name="onDataReload">() => this.onDataReload()</attribute>
        </xpath>
    </t>

</templates>

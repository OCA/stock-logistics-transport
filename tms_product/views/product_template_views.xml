<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form.inherit.tms.product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block" invisible="type == 'service'">
                    <field name="tms_vehicle" />
                    <label for="tms_vehicle" />
                </span>
            </xpath>
            <xpath expr="//field[@name='type']" position="after">
                <field
                    name="transport_type"
                    widget="radio"
                    options="{'horizontal': True}"
                    invisible="type != 'service'"
                />
                <field
                    name="transit_mode_cargo"
                    invisible="transport_type != 'cargo'"
                    required="transport_type == 'cargo'"
                />
                <field
                    name="transit_mode_passenger"
                    invisible="transport_type != 'passenger'"
                    required="transport_type == 'passenger'"
                />
                <field
                    name="booking_type"
                    invisible="transport_type not in ('cargo', 'passenger')"
                    required="transport_type in ('cargo', 'passenger')"
                />
                <field
                    name="vehicle_type"
                    invisible="not tms_vehicle"
                    required="tms_vehicle"
                />
                <field
                    name="model_id"
                    invisible="not vehicle_type"
                    required="tms_vehicle"
                    domain="[('vehicle_type', '=', vehicle_type)]"
                />
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_tms" model="ir.ui.view">
        <field name="name">product.template.search.inherit.tms.product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <separator />
                <filter
                    string="TMS Cargo Services"
                    name="tms_trip_services"
                    domain="[('transport_type', '=', 'cargo')]"
                />
                <filter
                    string="TMS Passenger Services"
                    name="tms_seat_services"
                    domain="[('transport_type', '=', 'passenger')]"
                />
            </xpath>
        </field>
    </record>
</odoo>

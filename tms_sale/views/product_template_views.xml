<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.transport.mode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="tms_product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='booking_type']" position="after">
                <field name="transit_mode" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
